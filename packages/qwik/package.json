{
  "name": "@css-hooks/qwik",
  "description": "CSS Hooks for Qwik",
  "version": "4.0.0-next.30",
  "author": "Nick Saunders",
  "dependencies": {
    "@css-hooks/core": "4.0.0-next.30"
  },
  "devDependencies": {
    "@qwik.dev/core": "^2.0.0-beta.30",
    "remeda": "^2.45.0"
  },
  "files": [
    "cjs",
    "esm",
    "types",
    "tsdoc-metadata.json",
    "!**/*.test.*"
  ],
  "license": "MIT",
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "type": "module",
  "sideEffects": false,
  "peerDependencies": {
    "@qwik.dev/core": ">=2.0.0-beta.30 <3"
  },
  "peerDependenciesMeta": {
    "@qwik.dev/core": {
      "optional": true
    }
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/css-hooks/css-hooks.git",
    "directory": "packages/qwik"
  },
  "scripts": {
    "build": "wireit",
    "codegen": "npm run --silent start -w @scripts/css-property-conflicts -- --casing camel --casing kebab > src/css-property-conflicts.ts",
    "prepublishOnly": "wireit",
    "test": "node --conditions @css-hooks/source --test src/index.test.ts"
  },
  "wireit": {
    "apix": {
      "command": "api-extractor run",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "tsc && tsc --project tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
      "dependencies": [
        "../core:build"
      ]
    },
    "prepublishOnly": {
      "dependencies": [
        "build"
      ]
    }
  },
  "types": "types",
  "exports": {
    ".": {
      "@css-hooks/source": "./src/index.ts",
      "import": "./esm/index.js",
      "require": "./cjs/index.js",
      "types": "./types/index.d.ts"
    }
  }
}
