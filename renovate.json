{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":reviewer(nsaunders)"],
  "baseBranches": ["next"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "description": "Block Microsoft tools that break Markdown output",
      "matchPackageNames": [
        "@microsoft/api-documenter",
        "@microsoft/api-extractor"
      ],
      "enabled": false
    },
    {
      "description": "Ignore internal monorepo packages",
      "matchPackagePatterns": ["^@css-hooks/"],
      "enabled": false
    },
    {
      "description": "Maintenance Monday: Group all minor/patch updates except fonts",
      "matchUpdateTypes": ["minor", "patch"],
      "excludePackagePatterns": ["^@fontsource"],
      "groupName": "weekly maintenance",
      "schedule": ["before 5am on monday"],
      "commitMessagePrefix": "misc:"
    },
    {
      "description": "Fonts: separate group to prevent clogging main PR",
      "matchPackagePatterns": ["^@fontsource"],
      "groupName": "fonts",
      "commitMessagePrefix": "misc:"
    },
    {
      "description": "Major updates: Manual only, no auto-merge, specific prefix",
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "BREAKING CHANGE:",
      "automerge": false
    },
    {
      "description": "Disable GitHub Action updates",
      "matchManagers": ["github-actions"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"],
    "commitMessagePrefix": "fix:",
    "automerge": false
  }
}
