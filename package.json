{
  "name": "css-hooks",
  "description": "Monorepo for @css-hooks/* packages",
  "version": "4.0.0-next.14",
  "type": "module",
  "scripts": {
    "docs": "wireit",
    "prepare": "husky"
  },
  "wireit": {
    "docs": {
      "command": "api-documenter markdown -i temp -o docs/api",
      "dependencies": [
        "./packages/core:apix",
        "./packages/preact:apix",
        "./packages/react:apix",
        "./packages/qwik:apix",
        "./packages/solid:apix"
      ]
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "packages/*",
    "example",
    "scripts/*",
    "site"
  ],
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@microsoft/api-documenter": "^7.26.29",
    "@microsoft/api-extractor": "^7.56.0",
    "@types/node": "^24.10.9",
    "commitlint": "^21.0.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-jsdoc": "^1.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.35.1",
    "wireit": "^0.14.12"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/css-hooks/css-hooks.git"
  }
}
