{
  "name": "@css-hooks/core",
  "description": "CSS Hooks core library",
  "version": "3.0.6-next.9",
  "author": "Nick Saunders",
  "devDependencies": {
    "color": "^5.0.3",
    "csstype": "^3.1.3",
    "lightningcss": "^1.23.0",
    "puppeteer": "^24.0.0",
    "remeda": "^2.16.0"
  },
  "files": [
    "cjs",
    "esm",
    "types",
    "tsdoc-metadata.json",
    "!**/*.test.*"
  ],
  "license": "MIT",
  "main": "cjs",
  "module": "esm",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/css-hooks/css-hooks.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "wireit",
    "prepublishOnly": "wireit",
    "test": "node --conditions @css-hooks/source --test src/index.test.ts"
  },
  "wireit": {
    "apix": {
      "command": "api-extractor run",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "tsc && tsc --project tsconfig.cjs.json"
    },
    "prepublishOnly": {
      "dependencies": [
        "build"
      ]
    }
  },
  "types": "types",
  "exports": {
    ".": {
      "@css-hooks/source": "./src/index.ts",
      "import": "./esm/index.js",
      "require": "./cjs/index.js",
      "types": "./types/index.d.ts"
    }
  }
}
