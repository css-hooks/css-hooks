{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":reviewer(nsaunders)"],
  "baseBranches": ["next"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "minimumReleaseAge": "3 days",
  "commitMessageAction": "update",
  "commitMessageTopic": "{{lowercase depName}}",
  "commitMessageExtra": "to v{{lowercase newVersion}}",
  "packageRules": [
    {
      "description": "Default major update prefix (Broadest rule)",
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "breaking:",
      "automerge": false
    },
    {
      "description": "Block Microsoft tools that break Markdown output",
      "matchPackageNames": [
        "@microsoft/api-documenter",
        "@microsoft/api-extractor"
      ],
      "enabled": false
    },
    {
      "description": "Ignore internal monorepo packages",
      "matchPackagePatterns": ["^@css-hooks/"],
      "enabled": false
    },
    {
      "description": "Override: Always use misc for devDependencies (prevents version bumps)",
      "matchDepTypes": ["devDependencies"],
      "commitMessagePrefix": "misc:"
    },
    {
      "description": "Override: Always use misc for non-package workspaces (site, example, scripts)",
      "matchFileNames": ["!(packages/**/package.json)"],
      "commitMessagePrefix": "misc:"
    },
    {
      "description": "Weekly Maintenance: Group all minor/patch updates except fonts",
      "matchUpdateTypes": ["minor", "patch"],
      "excludePackagePatterns": ["^@fontsource"],
      "groupName": "dependencies",
      "schedule": ["before 5am on saturday"],
      "commitMessagePrefix": "misc:"
    },
    {
      "description": "Fonts: separate group to prevent clogging main PR",
      "matchPackagePatterns": ["^@fontsource"],
      "groupName": "fonts",
      "commitMessagePrefix": "misc:"
    },
    {
      "description": "Disable eslint upgrades until ecosystem catches up",
      "matchPackageNames": ["eslint", "@eslint/js"],
      "allowedVersions": "<10.0.0"
    },
    {
      "description": "Disable GitHub Action updates",
      "matchManagers": ["github-actions"],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": ["security"],
    "commitMessagePrefix": "fix:",
    "automerge": false
  }
}
