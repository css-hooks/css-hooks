{
  "name": "@css-hooks/core",
  "description": "CSS Hooks core library",
  "version": "4.0.0-next.63",
  "author": "Nick Saunders",
  "devDependencies": {
    "color": "^5.0.3",
    "csstype": "^3.1.3",
    "lightningcss": "^1.23.0",
    "playwright": "^1.47.0",
    "tsx": "^4.23.15"
  },
  "files": [
    "cjs",
    "esm",
    "types",
    "tsdoc-metadata.json",
    "!**/*.test.*"
  ],
  "license": "MIT",
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "type": "module",
  "sideEffects": false,
  "private": false,
  "homepage": "https://next.css-hooks.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/css-hooks/css-hooks.git",
    "directory": "packages/core"
  },
  "scripts": {
    "build": "wireit",
    "prepublishOnly": "wireit",
    "test": "tsc && node --import tsx --conditions @css-hooks/source --test test/runtime.tsx"
  },
  "wireit": {
    "apix": {
      "command": "api-extractor run",
      "dependencies": [
        "build"
      ]
    },
    "build": {
      "command": "tsc --project tsconfig.esm.json && tsc --project tsconfig.cjs.json && node -e \"require('node:fs').writeFileSync('cjs/package.json', JSON.stringify({type:'commonjs'}))\""
    },
    "prepublishOnly": {
      "dependencies": [
        "build"
      ]
    }
  },
  "types": "types",
  "exports": {
    ".": {
      "@css-hooks/source": "./src/index.ts",
      "import": "./esm/index.js",
      "require": "./cjs/index.js",
      "types": "./types/index.d.ts"
    }
  }
}
